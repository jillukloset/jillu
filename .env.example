# Copy to .env and adjust as needed. Defaults match docker-compose.yml (local dev only —
# these are placeholder dev credentials, not secrets, and are safe to keep in this example file).
#
# For production, every value below is replaced with a real secret injected by your hosting
# platform's environment/secret manager (never committed): a managed Postgres URL, a freshly
# generated AUTH_SECRET, real Google OAuth credentials, a real S3/R2 bucket + IAM credentials,
# and a real SMTP provider (e.g. Resend/SES) in place of Mailhog. APP_URL becomes the production
# domain, and S3_FORCE_PATH_STYLE is typically "false" for AWS S3 / Cloudflare R2 (path-style is
# a MinIO-local convenience).

# Postgres
DATABASE_URL="postgresql://jillu:jillu@localhost:5433/jillu"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
APP_URL="https://jillukloset.shop"
# Auth.js validates the incoming Host header against AUTH_URL in production mode (`next start`)
# and rejects session/callback requests with an UntrustedHost error if it doesn't match —
# this only stays silent in `next dev`. Set this to the production domain in production.
AUTH_URL="https://jillukloset.shop"

# Google OAuth (optional — Google sign-in is disabled until both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Object storage (MinIO locally, S3/R2-compatible in production)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="jillu_admin"
S3_SECRET_ACCESS_KEY="jillu_admin_secret"
S3_BUCKET="jillu-media"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_URL="http://localhost:9000/jillu-media"

# Email (Mailhog locally — view sent mail at http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Jillu Kloset <noreply@jillukloset.com>"
